<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- 上层：扫码输入框 + 扫码按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etScanResult"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="扫码获取患者信息或手动输入编号"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="扫码"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 中间层：病人信息（左） + 检测操作（右） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <!-- 左侧：病人信息（全部为TextView，可手动输入） -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="条形码号：" />
                    <EditText android:id="@+id/etSpecimenNo" style="@style/InfoEditRight" />
                </LinearLayout>

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="患者类型：" />
                    <EditText android:id="@+id/etPatientType" style="@style/InfoEditRight" />
                </LinearLayout>

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="患者姓名：" />
                    <EditText android:id="@+id/etPatientName" style="@style/InfoEditRight" />
                </LinearLayout>

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="患者性别：" />
                    <EditText android:id="@+id/etPatientGender" style="@style/InfoEditRight" />
                </LinearLayout>

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="患者年龄：" />
                    <EditText android:id="@+id/etPatientAge" style="@style/InfoEditRight" />
                </LinearLayout>

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="联系电话：" />
                    <EditText android:id="@+id/etPhone" style="@style/InfoEditRight" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 右侧：检测操作（申请信息） -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="当前日期：" />
                    <TextView android:id="@+id/tvCurrentDate" style="@style/InfoValueRight" />
                </LinearLayout>

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="申请医生：" />
                    <EditText android:id="@+id/etApplyDoctor" style="@style/InfoEditRight" />
                </LinearLayout>

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="申请科室：" />
                    <EditText android:id="@+id/etApplyDept" style="@style/InfoEditRight" />
                </LinearLayout>

                <LinearLayout style="@style/HorizontalInfoRow">
                    <TextView style="@style/InfoLabelLeft" android:text="申请时间：" />
                    <TextView android:id="@+id/tvApplyTime" style="@style/InfoValueRight" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 下层：返回 + 三种疾病检测按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="返回"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnGI"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="胃肠道疾病检测"
            android:layout_marginEnd="8dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRBC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="红细胞寿命检测"
            android:layout_marginEnd="8dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnResp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="呼吸道疾病检测"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>